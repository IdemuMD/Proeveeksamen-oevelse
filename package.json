{
  "name": "foxvote",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "lint": "eslint \"backend/src/**/*.js\" \"backend/test/**/*.js\" \"frontend/src/**/*.js\" \"frontend/public/js/**/*.js\"",
    "test": "npm run test --workspace backend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "start": "concurrently \"npm run start --workspace backend\" \"npm run start --workspace frontend\""
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.1"
  }
}
