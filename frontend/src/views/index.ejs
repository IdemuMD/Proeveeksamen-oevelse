<!doctype html>
<html lang="no">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FoxVote</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <header class="site-header">
      <h1>FoxVote</h1>
      <p>Hvilken rev er søtest akkurat nå?</p>
    </header>

    <main class="container" id="appRoot">
      <section class="duel" aria-labelledby="duel-title">
        <h2 id="duel-title">Stem på den søteste reven</h2>
        <p id="statusMessage" class="status-message" aria-live="polite"></p>
        <p id="errorMessage" class="error-message" role="alert"></p>

        <div class="duel-grid" id="duelGrid">
          <article class="fox-card">
            <img id="leftImage" src="" alt="" loading="eager" />
            <button id="leftVoteButton" type="button" class="vote-button">
              Stem på venstre rev
            </button>
          </article>
          <article class="fox-card">
            <img id="rightImage" src="" alt="" loading="eager" />
            <button id="rightVoteButton" type="button" class="vote-button">
              Stem på høyre rev
            </button>
          </article>
        </div>
      </section>

      <section class="stats" aria-labelledby="stats-title">
        <h2 id="stats-title">Toppliste</h2>
        <ul id="topList" class="top-list"></ul>
      </section>
    </main>

    <div id="toast" class="toast" role="status" aria-live="assertive"></div>

    <script>
      window.APP_CONFIG = {
        backendBaseUrl: "<%= backendBaseUrl %>"
      };
    </script>
    <script src="/js/app.js"></script>
  </body>
</html>
